#   3. npx supabase secrets set AI_INFERENCE_API_HOST=https://ai.borgwithus.xyz
#   4. npx supabase secrets set BORG_AI_MODEL=llama2-uncensored
#   5. npm run supabase:deploy-ai
#   6. Supabase Auth → Site URL https://borgwithus.xyz, redirects https://borgwithus.xyz/**
