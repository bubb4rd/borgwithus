# Supabase — Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Local BORG AI (dev only — no Docker, no ngrok, no supabase functions serve)
VITE_BORG_AI_LOCAL=true
VITE_BORG_AI_MODEL=llama2-uncensored

# BORG AI daily limit — run supabase/borg-ai-daily-limit.sql in SQL editor

# Local dev (2 terminals, from borgwithus folder):
#   1. ollama pull llama2-uncensored   (Ollama usually auto-starts on Windows)
#   2. npm run dev
#   Sign in → Generator → BORG AI → Generate
#
# Production (24/7 GPU server with Ollama):
#   Remove VITE_BORG_AI_LOCAL from production env
#   npx supabase secrets set AI_INFERENCE_API_HOST=https://your-gpu-server:11434
#   npx supabase secrets set BORG_AI_MODEL=llama2-uncensored
#   npm run supabase:deploy-ai
